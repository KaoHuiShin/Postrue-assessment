rules_version = '2';

// =================================================================
// 演奏者智能照護系統 — Firestore Security Rules
// 貼到 Firebase Console → Firestore Database → 規則（Rules）→ 發布
//
// 原則：演奏者擁有自己資料的授權權；醫師／物理治療師須經演奏者主動授權
//       （bindings/{performerUid}_{providerUid}.status == 'active'）才能讀取。
// =================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function bindingPath(perf, prov) {
      return /databases/$(database)/documents/bindings/$(perf + '_' + prov);
    }
    // 目前登入者是否為該演奏者「已授權」的照護者
    function isActiveProviderOf(perf) {
      return signedIn()
        && exists(bindingPath(perf, request.auth.uid))
        && get(bindingPath(perf, request.auth.uid)).data.status == 'active';
    }

    // ── 演奏者資料 ───────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSelf(uid) || isActiveProviderOf(uid);
      allow write: if isSelf(uid);

      // 照護建議：只有已授權照護者可新增；只能改／刪自己寫的；演奏者唯讀
      match /notesFromProviders/{noteId} {
        allow read: if isSelf(uid) || isActiveProviderOf(uid);
        allow create: if isActiveProviderOf(uid) && request.resource.data.providerUid == request.auth.uid;
        allow update, delete: if isActiveProviderOf(uid) && resource.data.providerUid == request.auth.uid;
      }

      // 其他子集合（records、bodyMaps、questionnaires、practiceSessions、
      // medicalLogs、notes）：本人可讀寫；已授權照護者唯讀
      match /{sub}/{docId} {
        allow read: if isSelf(uid) || isActiveProviderOf(uid);
        allow write: if isSelf(uid) && sub != 'notesFromProviders';
      }
    }

    // ── 照護端資料 ───────────────────────────────────────────────
    match /providers/{pid} {
      // 已登入者可讀（供演奏者以邀請碼或 Email 搜尋照護者）
      allow read: if signedIn();
      allow write: if isSelf(pid);

      // followups（不推送的追蹤項目）、archives（歸檔）：僅本人
      match /{sub}/{docId} {
        allow read, write: if isSelf(pid);
      }
    }

    // ── 授權綁定 bindings/{performerUid}_{providerUid} ─────────────
    match /bindings/{bid} {
      // 單筆讀取：文件 ID 含自己的 uid 即可（文件不存在時也能判斷）
      allow get: if signedIn()
        && (bid.matches(request.auth.uid + '_.*') || bid.matches('.*_' + request.auth.uid));
      // 查詢：必須以 performerUid 或 providerUid == 自己 作為條件
      allow list: if signedIn()
        && (resource.data.performerUid == request.auth.uid || resource.data.providerUid == request.auth.uid);

      // 演奏者建立邀請（狀態只能是 pending）
      allow create: if signedIn()
        && request.resource.data.performerUid == request.auth.uid
        && bid == request.auth.uid + '_' + request.resource.data.providerUid
        && request.resource.data.status == 'pending';

      // 演奏者：可撤銷或重新邀請；照護者：可接受、婉拒或結束
      allow update: if signedIn()
        && request.resource.data.performerUid == resource.data.performerUid
        && request.resource.data.providerUid == resource.data.providerUid
        && (
          (resource.data.performerUid == request.auth.uid
             && request.resource.data.status in ['pending', 'revoked'])
          ||
          (resource.data.providerUid == request.auth.uid
             && resource.data.status in ['pending', 'active']
             && request.resource.data.status in ['active', 'declined', 'revoked'])
        );

      allow delete: if false;
    }
  }
}
